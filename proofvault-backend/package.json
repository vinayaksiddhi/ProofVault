{
  "name": "proofvault-backend",
  "version": "1.0.0",
  "description": "ProofVault core API: authentication, private document ingestion, canonical hashing, and blockchain relayer integration",
  "private": true,
  "main": "dist/server.js",
  "scripts": {
    "build": "tsc",
    "start": "node dist/server.js",
    "dev": "ts-node src/server.ts",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:deploy": "prisma migrate deploy",
    "prisma:status": "prisma migrate status",
    "test": "mocha -r ts-node/register \"test/**/*.test.ts\" --timeout 30000 --exit",
    "test:unit": "mocha -r ts-node/register \"test/receipt-validation.test.ts\" --timeout 15000 --exit",
    "test:db": "mocha -r ts-node/register \"test/{auth,db-connectivity,document-ingestion,document-lifecycle,coordination,blockchain-integration,reconciliation-worker}.test.ts\" --timeout 30000 --exit",
    "test:integration": "mocha -r ts-node/register \"test/live-evm-integration.test.ts\" --timeout 90000 --exit"
  },
  "dependencies": {
    "@prisma/client": "^5.17.0",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "ethers": "^6.13.4",
    "express": "^4.19.2",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.2",
    "multer": "^1.4.5-lts.1",
    "uuid": "^9.0.1"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/chai": "^4.3.16",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.6",
    "@types/mocha": "^10.0.7",
    "@types/multer": "^1.4.11",
    "@types/node": "^20.14.9",
    "@types/supertest": "^6.0.2",
    "@types/uuid": "^9.0.8",
    "chai": "^4.4.1",
    "mocha": "^10.7.0",
    "prisma": "^5.17.0",
    "rimraf": "^5.0.7",
    "supertest": "^7.0.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.5.4"
  }
}
